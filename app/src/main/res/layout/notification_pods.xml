<?xml version="1.0" encoding="utf-8"?>
<!--
    The ongoing notification's custom content view.

    One row: the device name on top, then three battery rings side by side.
    The rings are Bitmaps generated at runtime (see BatteryGlyph) because
    RemoteViews cannot host Compose and a per-level drawable set would be
    hundreds of assets.

    Deliberately plain: RemoteViews supports a restricted widget subset, and
    anything clever here is what breaks on an OEM skin. The app falls back to
    the standard template when this cannot be inflated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <!--
            Three equal columns. Weighted rather than fixed-width so the row
            stays correct at any font scale and on any shade width.
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/glyph_left"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/pod_left" />

            <TextView
                android:id="@+id/label_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/pod_left"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/glyph_right"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/pod_right" />

            <TextView
                android:id="@+id/label_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/pod_right"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/glyph_case"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/pod_case" />

            <TextView
                android:id="@+id/label_case"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/pod_case"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
