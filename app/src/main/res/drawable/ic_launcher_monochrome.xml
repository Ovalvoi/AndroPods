<?xml version="1.0" encoding="utf-8"?>
<!--
    The themed-icon layer.

    Android tints this a single colour from the user's wallpaper palette, so
    it must be one flat silhouette: the green arc and the white bud would both
    collapse to the same tint and the ring would merge into the bud. Drawn
    instead as the lit arc alone with a clear gap around the bud, so the shape
    still reads after tinting.

    Same geometry as the colour layer, concentric on (54, 54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M54,28 A26,26 0 1 1 28.46,49.13" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,48.25m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50.5,55.25h7v12.5a3.5,3.5 0,0 1,-7 0z" />
</vector>
