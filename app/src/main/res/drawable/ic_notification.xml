<?xml version="1.0" encoding="utf-8"?>
<!--
    The status-bar icon.

    A single bud in a battery ring, matching the launcher mark so the two read
    as the same app. Android renders this as a flat silhouette at ~24dp, so
    everything is one colour and the shapes are kept well apart: a thinner
    ring or a tighter gap turns to a smudge at status-bar size.

    Concentric on (12, 12): the ring, and the bud's full span including its
    stem, so nothing sits visibly off-centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,2.5 A9.5,9.5 0 1 1 2.67,10.22" />

    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,9.7m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10.7,12.3h2.6v3.7a1.3,1.3 0,0 1,-2.6 0z" />
</vector>
