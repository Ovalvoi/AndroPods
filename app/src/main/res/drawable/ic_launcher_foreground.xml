<?xml version="1.0" encoding="utf-8"?>
<!--
    A single AirPod inside a battery ring.

    The mark says "AirPods" and "battery charge" at once, in the same visual
    language as the readout: the same ring, the same green, the same gap at
    twelve o'clock where a gauge starts. One bud rather than a pair because
    two silhouettes plus a ring turn to mush below ~40dp.

    Everything is concentric on (54, 54), the canvas centre: the ring, and the
    bud's own vertical span (its housing plus stem). Centring the bud on its
    housing instead would sit it visibly low inside the ring, because the stem
    hangs below.

    The whole mark stays inside the 72dp safe zone of the 108dp canvas, since
    a launcher may mask this to a circle, a squircle or a rounded square.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        The unlit track, drawn full-circle underneath the lit arc so the gauge
        reads as a level on a track, not as a broken circle.
    -->
    <path
        android:strokeColor="#2E3550"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M54,28 A26,26 0 1 1 53.9,28" />

    <!--
        The lit arc: 78%, clockwise from twelve o'clock. A partial sweep reads
        as a measurement; a full circle would just look like a border.
    -->
    <path
        android:strokeColor="#22A04A"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M54,28 A26,26 0 1 1 28.46,49.13" />

    <!-- The bud: housing, then stem. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,48.25m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50.5,55.25h7v12.5a3.5,3.5 0,0 1,-7 0z" />
</vector>
