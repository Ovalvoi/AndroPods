<?xml version="1.0" encoding="utf-8"?>
<!--
    The icon's backdrop: the app's own deep navy with a soft violet lift
    toward the top-left, so the mark sits on the same surface the app draws.

    A vector rather than a flat colour because an adaptive icon's background
    is scaled and masked by the launcher, and a gradient survives that where
    a bitmap would band.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#1A1B33" />
                <item android:offset="0.55" android:color="#0E0F1C" />
                <item android:offset="1" android:color="#0B0C14" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
